# Copy to .env and adjust. .env is gitignored.
# Placeholder scaffolded at M0 — keys firm up as milestones land.

# --- Headless rendering (MuJoCo inside WSL2/Docker) ---
# osmesa = CPU software GL (default; no GPU needed). Use egl only where a GPU
# and driver are actually available inside the container.
MUJOCO_GL=osmesa
PYOPENGL_PLATFORM=osmesa

# --- Asset fetch ---
# Menagerie ref to fetch; leave unset to use the pinned SHA in
# assets/menagerie.lock.json (or resolve "main" on the first fetch).
# MENAGERIE_REF=

# --- Paths ---
OUTPUTS_DIR=outputs
CATALOG_DB=outputs/catalog.sqlite
ASSETS_DIR=assets/menagerie

# --- DROID replay bridge (Project-2 source) ---
# Curated episode source + index (verify against the real dataset before use).
DROID_SOURCE=lerobot/droid_100
DROID_EPISODE_INDEX=3

# --- Blender hero render (Windows HOST only, not the container) ---
# Path to the host Blender executable used by the optional hero-render step.
BLENDER_EXE=C:/Program Files/Blender Foundation/Blender 4.2/blender.exe
